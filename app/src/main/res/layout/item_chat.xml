<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Pesan dari Kaia (kiri) -->
    <LinearLayout
        android:id="@+id/layoutKaia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:visibility="gone">

        <!-- Avatar Kaia kecil -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🤖"
                android:textSize="16sp"/>

        </androidx.cardview.widget.CardView>

        <!-- Balon chat Kaia -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:orientation="vertical"
            android:maxWidth="260dp">

            <TextView
                android:id="@+id/tvKaiaMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_kaia"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"/>

            <TextView
                android:id="@+id/tvKaiaTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginStart="4dp"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Pesan dari User (kanan) -->
    <LinearLayout
        android:id="@+id/layoutUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:visibility="gone">

        <!-- Balon chat User -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:maxWidth="260dp">

            <TextView
                android:id="@+id/tvUserMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_user"
                android:padding="12dp"
                android:textColor="#5A67D8"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"/>

            <TextView
                android:id="@+id/tvUserTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="4dp"
                android:layout_gravity="end"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>